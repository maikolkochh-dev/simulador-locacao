# ==========================================================================
# CONFIGURAÇÕES DE SMTP PARA O LOCADOR NÔMADE - SISTEMAS ESSENCIAIS
# ==========================================================================
# Preencha as configurações abaixo com as credenciais do seu provedor de e-mail.
# Exemplos comuns: Gmail (com Senha de App), SendGrid, Mailgun, Outlook, Resend, etc.
# Se deixadas em branco, o sistema usará automaticamente o Ethereal (serviço de teste temporário).

# Host SMTP do seu provedor (Ex: smtp.gmail.com para Gmail, smtp.sendgrid.net para SendGrid)
SMTP_HOST=

# Porta SMTP (Normalmente 587 para TLS/STARTTLS ou 465 para SSL seguro)
SMTP_PORT=587

# Usuário do SMTP (Normalmente seu endereço de e-mail completo)
SMTP_USER=

# Senha do SMTP (Para o Gmail, use uma "Senha de App" gerada na sua Conta do Google)
SMTP_PASS=

# Definir como 'true' para usar SSL direto (Porta 465) ou 'false' para TLS (Porta 587)
SMTP_SECURE=false

# Nome e E-mail de remetente (Ex: "LOCADOR NÔMADE" <seu_email@dominio.com>)
SMTP_FROM="LOCADOR NÔMADE" <noreply@locadornomade.com.br>
